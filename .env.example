# ==============================================================================
# FLAREHQ CORE PLATFORM CONFIGURATIONS — EXAMPLE
# Copy to .env and fill with real secrets. Do NOT commit real secrets.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# COMMON — network selection + everything needed in BOTH testnet and mainnet
# ──────────────────────────────────────────────────────────────────────────────

# ── ARC NETWORK SELECTION (authoritative switch) ──
# "testnet" (default) or "mainnet". Anything other than "mainnet" = testnet.
# The authoritative network layer (src/lib/config/network.ts) resolves EVERY Arc
# network value (chain ID, Circle blockchain, RPCs, explorer, Gateway/Iris URLs,
# CCTP domain + MessageTransmitter, x402 network/verifier, USDC/EURC/ERC-8183)
# from this single switch. Testnet never requires mainnet-only variables.
# Selecting mainnet FAILS CLOSED at startup if any ARC_MAINNET_* variable below
# is missing — testnet values are never silently inherited.
# ARC_NETWORK=mainnet
# NEXT_PUBLIC_ARC_NETWORK=testnet   # optional browser-side selection override

# 💳 NATIVE USDC SYSTEM CONTRACT ON ARC (legacy per-call override; the
#    authoritative network config already supplies the correct per-network
#    value — set only to force a custom token address)
ARC_USDC_ADDRESS="0x3600000000000000000000000000000000000000"

# 💼 FLAREHQ MERCHANT COLLECTION WALLET
ARCFLARE_MERCHANT_WALLET="0xbD3FAD84e7a41D222c7C36947B0A3B1592F42154"

# 🔒 SECURITY & WEBHOOK DISPATCH KEYS
ARCFLARE_WEBHOOK_SECRET=af_sec_live_xxx
MERCHANT_WEBHOOK_ENDPOINT="http://localhost:3000/api/merchant-webhook"

# 💾 DATABASE ENVIRONMENT
# Only ONE DATABASE_URL line — a duplicate key silently wins the FIRST occurrence.
# Neon is the only production database (a *.neon.tech host). The legacy Render
# Postgres instance is DEAD/DEPRECATED — never point DATABASE_URL at render.com.
DATABASE_URL="postgresql://user:password@localhost:5432/flarehq_db?sslmode=require"

# 🔑 WALLETCONNECT (project ID is public and safe to expose; the chain/network
#    it connects to now flows from the ARC network selection above)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id

CIRCLE_API_KEY=TEST_API_KEY:xxx
CIRCLE_ENTITY_SECRET=xxx

# ── CIRCLE USER-CONTROLLED WALLETS (consumer Google / email-OTP onboarding) ──
# Individual/consumer "FlareHQ wallet" sign-in uses Circle's USER-CONTROLLED
# wallet model (Web SDK + this server as a thin API proxy) — NOT the
# developer-controlled wallets above. All three values are public identifiers
# except CIRCLE_API_KEY (already above, reused as the proxy credential).
# No private keys or user key material are ever stored server-side.
#
# Setup (cannot be completed from code — Circle/Google consoles required):
#   1. Google Cloud Console → new project → Google Auth Platform → app name,
#      support email, audience External → Create OAuth client (Web
#      application) → Authorized redirect URIs: your origin(s), e.g.
#      http://localhost:3000 for dev and https://<your-domain> for prod →
#      copy the OAuth Client ID. Publish the app (Audience → Publish) so
#      non-test users can sign in.
#   2. Circle Developer Console → Wallets → User Controlled → Configurator →
#      Authentication Methods → Social Logins → Google → paste the Google
#      OAuth Client ID into "Client ID (Web)".
#   3. Same Configurator page → Authentication Methods → Email → From address
#      + your SMTP host/port/username/password (Circle sends OTPs through
#      YOUR provider — there is no FlareHQ/Circle fallback sender).
#   4. Same Configurator page → copy the App ID → CIRCLE_APP_ID below.
# See docs/consumer-circle-auth.md for the full checklist and UX mapping.
CIRCLE_APP_ID=xxx
# Optional Circle REST override (must stay https; default https://api.circle.com).
# CIRCLE_BASE_URL=https://api.circle.com
# Browser-visible identifiers (safe to expose — they identify, not authorize):
# NEXT_PUBLIC_CIRCLE_APP_ID=xxx   # same value as CIRCLE_APP_ID
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com  # Step 1 client ID
ARC_ADMIN_PRIVATE_KEY=0x...
ADMIN_SECRET=your_admin_secret
INTERNAL_SETTLEMENT_API_KEY=arc_live_xxx
NEXT_PUBLIC_FACTORY_ADDRESS=0x...
NEXT_PUBLIC_VALIDATION_REGISTRY=0x...
NEXT_PUBLIC_CHECKOUT_API_KEY=ac_pub_xxx
SELLER_ADDRESS=0xc119bb61dCd7Ce422557485ecD17D679f44250a1
# Platform fee in basis points (25 = 0.25%, e.g. 25bps on a $100 checkout = $0.25) — debited from Circle merchant wallet after checkout SUCCESS
PLATFORM_FEE_BPS=25
SELLER_PRIVATE_KEY=0x...
EOA_PRIVATE_KEY=0x...
PRIVATE_KEY=0x...
BUYER_ADDRESS=0x...
BUYER_PRIVATE_KEY=0x...
AGENT_TOKEN_ID=851225
CIRCLE_WALLET_SET_ID=xxx
PAYROLL_CONTRACT_ADDRESS=0x...
SPEND_LIMIT_CONTRACT_ADDRESS=0x...
ARC_FLARE_STREAM_CONTRACT_ADDRESS=0x...
SWAP_POOL_CONTRACT_ADDRESS=0x...
X402_WALLET_ENCRYPTION_KEY=xxx
MERCHANT_JWT_SECRET=xxx
CONSUMER_JWT_SECRET=xxx
ADMIN_JWT_SECRET=xxx
TELEGRAM_BOT_TOKEN=xxx
TELEGRAM_BOT_USERNAME=FlareHQ_Notifier_bot
TELEGRAM_WEBHOOK_SECRET=xxx

# ──────────────────────────────────────────────────────────────────────────────
# ARC TESTNET (default environment — these are the live, verified testnet values)
# ──────────────────────────────────────────────────────────────────────────────
# Primary RPC override. Authoritative default (already correct):
#   https://rpc.testnet.arc.network
ARC_TESTNET_RPC="https://rpc.testnet.arc.network"
# Optional EXTRA fallback RPCs (comma-separated). The authoritative fallback
# list (dRPC / QuickNode / arc.io / Blockdaemon testnet endpoints) is always
# used; entries here are prepended for local/dev overrides.
# ARC_TESTNET_RPC_FALLBACKS=""

# ──────────────────────────────────────────────────────────────────────────────
# ARC MAINNET — required ONLY when ARC_NETWORK=mainnet (fail-closed otherwise)
# ──────────────────────────────────────────────────────────────────────────────
# Every variable below is REQUIRED the moment mainnet is selected; the process
# refuses to start with any of them missing. NEVER copy testnet values into
# these fields — each must be set explicitly, even when the mainnet value
# happens to equal the testnet one (fail-closed means explicit, not inherited).
#
# Verification status 2026-09-22 (post-launch; Arc public mainnet live since
# 2026-09-16 per circle.com pressroom): the CONFIRMED entries below were read
# directly from official sources —
#   * docs.arc.io/arc/references/rpc-endpoints (chain IDs, RPC URLs, explorers)
#   * docs.arc.io/arc/references/contract-addresses (USDC/EURC/CCTP/Gateway contracts, domain 26)
#   * developers.circle.com/cctp/references/contract-addresses (CCTP mainnet set, Arc domain 26)
#   * developers.circle.com/cctp/references/technical-guide (Iris hosts: testnet
#     https://iris-api-sandbox.circle.com, mainnet https://iris-api.circle.com)
# NOTE: docs.arc.io still marks the mainnet RPC/explorer as permissioned
# (credentials via your Circle point of contact) — confirm access before
# scheduling the mainnet contract deployment.
# Entries marked UNVERIFIED have no official publication found — confirm with
# Circle/your point of contact before setting; do not guess.
#
# --- CONFIRMED mainnet values (official docs, verified 2026-09-22) ---
# ARC_MAINNET_CHAIN_ID=5042                                    # EVM chain ID (testnet: 5042002)
# ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io               # primary JSON-RPC (also: rpc.blockdaemon.mainnet.arc.io, rpc.drpc.mainnet.arc.io, rpc.quicknode.mainnet.arc.io)
# ARC_MAINNET_RPC_FALLBACKS=                                   # optional comma-separated fallback RPCs
# ARC_MAINNET_EXPLORER_URL=https://explorer.arc.io             # block explorer base URL (no trailing slash)
# ARC_MAINNET_GATEWAY_URL=https://gateway-api.circle.com       # Circle Gateway / x402 facilitator base URL
# ARC_MAINNET_CCTP_IRIS_URL=https://iris-api.circle.com/v2     # CCTP Iris API base incl. version path
# ARC_MAINNET_CCTP_DOMAIN=26                                   # CCTP V2 domain for Arc (same value as testnet)
# ARC_MAINNET_CCTP_MESSAGE_TRANSMITTER=0x81D40F21F12A8F0E3252Bccb954D722d4c464B64  # CCTP V2 MessageTransmitter (mainnet set; testnet pin was 0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275)
#   # CCTP V2 TokenMessenger on Arc mainnet: 0x28b5a0e9C621a5BadaA536219b3a228C8168cf5d (domain 26; testnet pin was 0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA)
# ARC_MAINNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000  # native USDC ERC-20 interface, 6 decimals (SAME address as testnet — set explicitly anyway)
# ARC_MAINNET_EURC_ADDRESS=0xbEf5f6d51CB62b58e6A8f77868681825C6fe21c1  # EURC, 6 decimals (testnet pin was 0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a)
# ARC_MAINNET_ERC8183_ADDRESS=0x...                            # AgenticCommerce — MUST be a fresh mainnet value (fill post-deploy; never copy testnet)
# ARC_MAINNET_X402_VERIFIER=0x...                              # UNVERIFIED — x402 GatewayWalletBatched verifying contract on mainnet is unconfirmed
#                                                              # (testnet pin 0x0077777d7EBA4688BDeF3E311b846F25870A19B9; mainnet GatewayWallet is
#                                                              # 0x77777777Dcc4d5A8B6E418Fd04D8997ef11000eE but its x402-verifier role is NOT confirmed)
# --- UNVERIFIED / operator-supplied ---
# ARC_MAINNET_CIRCLE_BLOCKCHAIN=                               # Circle wallets blockchain id — UNVERIFIED (testnet: "ARC-TESTNET"; "ARC" is
#                                                              # expected but NOT officially confirmed — verify with Circle docs before setting)
#
# Derived identifiers (optional — auto-derived from ARC_MAINNET_CHAIN_ID when unset):
# ARC_MAINNET_EIP155=                    # default: eip155:<ARC_MAINNET_CHAIN_ID>
# ARC_MAINNET_X402_NETWORK=              # default: same as ARC_MAINNET_EIP155
# ARC_MAINNET_WALLETCONNECT_CHAIN_ID=    # default: same as ARC_MAINNET_EIP155
#
# ── Deployment-time only (NEVER set on the Next.js server; hardhat/scripts only) ──
# PRIVATE_KEY=0x...                      # arc-testnet deployer (hardhat.config.js)
# MAINNET_DEPLOYER_KEY=0x...             # dedicated arc-mainnet deployer (hardhat "arc-mainnet" network).
#                                        # Generate fresh; NEVER reuse a testnet key or any operational signer.
# ARC_MAINNET_RPC_URL is reused by hardhat as the arc-mainnet endpoint.
# Job-escrow constructor roles (scripts/deploy-arcflare.mjs; review before mainnet):
# JOB_ESCROW_OWNER=0x...                 # optional, defaults to deployer
# JOB_ESCROW_ARBITER=0x...               # required at deploy time
# JOB_ESCROW_TREASURY_SINK=0x...         # required at deploy time
# JOB_ESCROW_RELAYER=0x...               # required at deploy time
# SPEND_LIMIT_OWNER=0x...                # optional, defaults to JOB_ESCROW_OWNER
# SPEND_LIMIT_RECORDER=0x...             # optional, defaults to JOB_ESCROW_RELAYER
# Payroll constructor roles (scripts/deploy-payroll.mjs):
# PAYROLL_OWNER=0x...                    # optional, defaults to deployer
# PAYROLL_RELAYER=0x...                  # optional, defaults to JOB_ESCROW_RELAYER
#
# ── Contract addresses (fill post-deploy; startup fails closed when missing) ──
# Testnet pins live in code; on mainnet each MUST be the fresh mainnet deploy
# (never copy testnet). See REQUIRED_CONTRACT_ADDRESSES in walletEnvCheck.ts:
# PAYROLL_CONTRACT_ADDRESS=0x...         # ArcFlarePayroll.sol (scripts/deploy-payroll.mjs)
# SPEND_LIMIT_CONTRACT_ADDRESS=0x...     # ArcFlareSpendLimit.sol (scripts/deploy-arcflare.mjs)
# SWAP_POOL_CONTRACT_ADDRESS=0x...       # ArcFlareSwapPool.sol (scripts/deploy-swap-pool.mjs)
# JOB_ESCROW_CONTRACT_ADDRESS=0x...      # ArcFlareJobEscrow.sol (scripts/deploy-arcflare.mjs)
# ARC_FLARE_STREAM_CONTRACT_ADDRESS=0x... # ArcFlareStream.sol (scripts/deploy-stream.mjs)
# PAYMENT_ROUTER_CONTRACT_ADDRESS=0x...  # ArcFlarePaymentRouter.sol (scripts/deploy-payment-router.mjs)
# ARCFLARE_ESCROW_CONTRACT_ADDRESS=0x... # deployed FlareHQEscrow (see src/lib/wallet/flarehqContracts.ts)
# ARCFLARE_STREAM_CONTRACT_ADDRESS=0x... # legacy alias of the stream deployment above
# ERC-8004 registries on mainnet (confirm against official Arc/Circle sources):
# IDENTITY_REGISTRY_ADDRESS=0x...        # testnet pin 0x8004A818BFB912233c491871b3d84c89A494BD9e
# REPUTATION_REGISTRY_ADDRESS=0x...      # testnet pin 0x8004B663056A597Dffe9eCcC1965A193B7388713
# VALIDATION_REGISTRY_ADDRESS=0x...      # testnet pin 0x8004Cb1BF31DAf7788923b405b754f57acEB4272
# NEXT_PUBLIC_FACTORY_ADDRESS=0x...      # public factory pin (client-visible; confirm mainnet value)
# NEXT_PUBLIC_VALIDATION_REGISTRY=0x...  # public validation pin (client-visible; confirm mainnet value)
#
# ── Deploy-script token overrides (testnet defaults preserved; mainnet fail-closed) ──
# SWAP_POOL_TOKEN_A=                   # swap-pool tokenA (default: testnet USDC; mainnet: REQUIRED)
# SWAP_POOL_TOKEN_B=                   # swap-pool tokenB (default: testnet EURC; mainnet: REQUIRED)
# ROUTER_TOKEN_A=                      # payment-router tokenA (default: testnet USDC; mainnet: REQUIRED)
# ROUTER_TOKEN_B=                      # payment-router tokenB (default: testnet EURC; mainnet: REQUIRED)
#
# ── Canonical settle defaults (explicit on mainnet, testnet pins otherwise) ──
# PLATFORM_PAYER_WALLET_ID=            # platform-default Circle wallet id (mainnet: REQUIRED, else settle throws)
# MERCHANT_SCA_ADDRESS=0x...           # platform-default merchant SCA (mainnet: REQUIRED, else settle throws)
# PLATFORM_PAYER_SCA=0x...             # platform shared default payer SCA for nano/scheduled flows
#                                      # (mainnet: REQUIRED, else nano/scheduled throw; testnet pin is code-pinned)
#
# ── CCTP mainnet portability (testnet Sepolia/Amoy set is code-pinned) ──
# Mainnet status (verified 2026-09-13 against official Circle docs):
# - Iris API hosts are official: testnet https://iris-api-sandbox.circle.com,
#   mainnet https://iris-api.circle.com (developers.circle.com/cctp — "CCTP
#   technical guide" + IrisClient docs). ARC_MAINNET_CCTP_IRIS_URL is still
#   env-required (fail-closed); the expected production value is
#   https://iris-api.circle.com/v2.
# - Gateway API hosts are official: testnet https://gateway-api-testnet.circle.com,
#   mainnet https://gateway-api.circle.com (developers.circle.com Gateway OpenAPI
#   servers list). ARC_MAINNET_GATEWAY_URL is still env-required; the expected
#   production value is https://gateway-api.circle.com.
# - Arc mainnet is NOT yet in the Gateway supported-blockchains table and has
#   NO member in the installed @circle-fin/bridge-kit@1.13.0 BridgeChain enum
#   (Arc_Testnet only) — mainnet bridging stays fail-closed until Circle ships
#   both. Do not invent the destination enum; verify against the installed
#   package first.
# CCTP_MAINNET_SOURCES_JSON=           # mainnet: REQUIRED JSON array of { id, label, circleBlockchain }
#                                      # (confirm ids + Circle blockchain ids against Circle/BridgeKit docs;
#                                      # each id must be a BridgeChain member of the installed bridge-kit)
# CCTP_MAINNET_ARC_CHAIN_ID=           # mainnet: REQUIRED BridgeKit Arc destination enum (expected 'Arc', UNVERIFIED —
#                                      # verify against installed @circle-fin/bridge-kit BridgeChain enum first)
#
# ── Swap / routing providers (all default-OFF; enable only after verification) ──
# ROUTING_PROVIDER_TOWER_ENABLED=        # "1"/"true" to enable Tower quoting (needs TOWER_SWAP_API_KEY)
# ROUTING_PROVIDER_UNITFLOW_V3_ENABLED=  # "1"/"true" to enable UnitFlow V3 execution
# TOWER_SWAP_API_KEY=                    # server-only; never NEXT_PUBLIC_*
# TOWER_SWAP_BASE_URL=                   # optional; must be https (default https://www.tower.exchange)
# UNITFLOW_MAINNET_FACTORY=              # required when UnitFlow runs on mainnet
# UNITFLOW_MAINNET_QUOTER=               # required when UnitFlow runs on mainnet
# UNITFLOW_MAINNET_UNIVERSAL_ROUTER=     # required when UnitFlow runs on mainnet
# UNITFLOW_MAINNET_PERMIT2=              # required when UnitFlow runs on mainnet
# UNITFLOW_MAINNET_WUSDC=                # required when UnitFlow runs on mainnet
# UNITFLOW_MAINNET_CHAIN_ID=             # optional; chain id bound into UnitFlow mainnet envelopes
#
# ── Operations / third-party (configure outside the repo before launch) ──
# UPSTASH_REDIS_REST_URL=                # rate limiting (falls back to in-memory without it)
# UPSTASH_REDIS_REST_TOKEN=
# RESEND_API_KEY=xxx                     # notifications (lazy init in notifications.ts; email channel disabled when unset)
# RESEND_FROM_EMAIL=                     # optional override (default onboarding@resend.dev)
# GROQ_API_KEY=                          # agent brain LLM
# GROQ_MODEL=                            # optional (default openai/gpt-oss-20b)
# SENTRY_DSN= / SENTRY_*                 # see sentry configs; confirm DSN + tracesSampleRate for prod
# NEXT_PUBLIC_BASE_URL=                  # canonical public origin for outbound links (checkout/escrow/QR/cards).
#                                        # Legacy alias NEXT_PUBLIC_API_BASE still honored. Local dev falls back to
#                                        # http://localhost:3000; production WITHOUT either var fails closed (throws).
# NEXT_PUBLIC_CHECKOUT_API_KEY=ac_pub_xxx
# INTERNAL_SETTLEMENT_API_KEY=arc_live_xxx
# ADMIN_SECRET=your_admin_secret
# CIRCLE_API_KEY=TEST_API_KEY:xxx        # mainnet: production Circle API key
# CIRCLE_ENTITY_SECRET=xxx               # mainnet: production entity secret
# CIRCLE_WALLET_SET_ID=xxx               # mainnet: production wallet set
# CIRCLE_ARC_BLOCKCHAIN_ID=              # optional override; default flows from ARC network config
# GAS_SPONSORSHIP_AMOUNT_WEI=            # optional gas sponsorship override
# PLATFORM_FEE_BPS=25
# TELEGRAM_BOT_TOKEN=xxx
# TELEGRAM_BOT_USERNAME=FlareHQ_Notifier_bot
# TELEGRAM_WEBHOOK_SECRET=xxx
