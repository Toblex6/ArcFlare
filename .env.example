#     no constructor args, no roles (poster-is-authority model)
# All six live mainnet contracts share deployer 0xf17F0CC51973ba369a16e1C5355B5c6eE8BBc6B2 (throwaway signer, NO admin role anywhere).
# ABANDONED (wrong roles — owner=recorder=0x03ba testnet relayer, unrecoverable,
# inert, never wire): ArcFlareSpendLimit 0x62CadfEdb71b31Efa590154eDb5F3e58B5b3A4fA (tx 0xe0dba44e18f0fe8a1ab5da90409a3a96125f57de53f1eb0298bbd76ddc5e341e)
# To run the app against mainnet, set (in the MAINNET environment only):
# JOB_ESCROW_CONTRACT_ADDRESS=0x017F4616d2ed07E3Ed4A5d8B2355ab4A19f5fC65
# SPEND_LIMIT_CONTRACT_ADDRESS=0xF9DA48a0165aA4D15F9db7431C1bA5E10513CEFE
# PAYROLL_CONTRACT_ADDRESS=0x456E10375715A06509D86B9851F1e4Ef6F9F6B8B
# ── Deploy-script token overrides (testnet defaults preserved; mainnet fail-closed) ──
# SWAP_POOL_TOKEN_A=                   # swap-pool tokenA (default: testnet USDC; mainnet: REQUIRED)
# SWAP_POOL_TOKEN_B=                   # swap-pool tokenB (default: testnet EURC; mainnet: REQUIRED)
# ROUTER_TOKEN_A=                      # payment-router tokenA (default: testnet USDC; mainnet: REQUIRED)
# ROUTER_TOKEN_B=                      # payment-router tokenB (default: testnet EURC; mainnet: REQUIRED)
#
# ── Canonical settle defaults (explicit on mainnet, testnet pins otherwise) ──
# PLATFORM_PAYER_WALLET_ID=            # platform-default Circle wallet id (mainnet: REQUIRED, else settle throws)
# MERCHANT_SCA_ADDRESS=0x...           # platform-default merchant SCA (mainnet: REQUIRED, else settle throws)
# PLATFORM_PAYER_SCA=0x...             # platform shared default payer SCA for nano/scheduled flows
#                                      # (mainnet: REQUIRED, else nano/scheduled throw; testnet pin is code-pinned)
#
# ── CCTP mainnet portability (testnet Sepolia/Amoy set is code-pinned) ──
# Mainnet status (verified 2026-09-13 against official Circle docs):
# - Iris API hosts are official: testnet https://iris-api-sandbox.circle.com,
#   mainnet https://iris-api.circle.com (developers.circle.com/cctp — "CCTP
#   technical guide" + IrisClient docs). ARC_MAINNET_CCTP_IRIS_URL is still
#   env-required (fail-closed); the expected production value is
#   https://iris-api.circle.com/v2.
# - Gateway API hosts are official: testnet https://gateway-api-testnet.circle.com,
#   mainnet https://gateway-api.circle.com (developers.circle.com Gateway OpenAPI
#   servers list). ARC_MAINNET_GATEWAY_URL is still env-required; the expected
#   production value is https://gateway-api.circle.com.
# - Arc mainnet is NOT yet in the Gateway supported-blockchains table and has
#   NO member in the installed @circle-fin/bridge-kit@1.13.0 BridgeChain enum
#   (Arc_Testnet only) — mainnet bridging stays fail-closed until Circle ships
#   both. Do not invent the destination enum; verify against the installed
#   package first.
# CCTP_MAINNET_SOURCES_JSON=           # mainnet: REQUIRED JSON array of { id, label, circleBlockchain }
#                                      # (confirm ids + Circle blockchain ids against Circle/BridgeKit docs;
#                                      # each id must be a BridgeChain member of the installed bridge-kit)
# CCTP_MAINNET_ARC_CHAIN_ID=           # mainnet: REQUIRED BridgeKit Arc destination enum (expected 'Arc', UNVERIFIED —
#                                      # verify against installed @circle-fin/bridge-kit BridgeChain enum first)
#
# ── Swap / routing providers (all default-OFF; enable only after verification) ──
# ROUTING_PROVIDER_TOWER_ENABLED=        # "1"/"true" to enable Tower quoting (needs TOWER_SWAP_API_KEY)
# ROUTING_PROVIDER_UNITFLOW_V3_ENABLED=  # "1"/"true" to enable UnitFlow V3 execution
#
# ── Tower (quote/rate-comparison ONLY — never execution; UnitFlow executes) ──
# Official docs: docs.tower.exchange (Developer Console) + devs.tower.exchange
# (console). Findings recorded 2026-09-23:
#   * ONE gateway for BOTH networks: https://www.tower.exchange (public API
#     root https://www.tower.exchange/api/public) — no separate mainnet
#     endpoint exists. Testnet and mainnet share the base URL AND the key.
#   * Auth: Authorization: Bearer <key> (or x-api-key header), HTTPS only.
#     Keys look like sk_live_<hex> / sk_test_<hex> — generate at
#     devs.tower.exchange → API Keys with scopes `read` (dexes/prices) +
#     `swaps` (quote). /swap/quote (2 CU) 403s without the `swaps` scope.
#     NEVER use /swap/build-tx — FlareHQ executes via UnitFlow only.
#   * Tokens: USDC/EURC/USDT/cirBTC (+ cNGN/QCAD); venues aggregated include
#     Synthra, UnitFlow, Tower DEX. Quotes echo contract addresses — FlareHQ
#     always SENDS explicit per-network addresses (mainnet: ARC_MAINNET_*
#     above; cirBTC is testnet-only and refuses on mainnet).
#   * STATUS 2026-09-23: NO Tower mainnet API key is configured in this
#     environment (TOWER_SWAP_API_KEY absent) — Tower paths run in clearly
#     labeled fallback mode (consulted/available flags; the UI shows
#     "Rate comparison via Tower" ONLY after a successful consultation).
#     Obtain a key from the Tower Developer Console before enabling.
# TOWER_SWAP_API_KEY=                    # server-only; never NEXT_PUBLIC_* (REQUIRED to enable Tower)
# TOWER_SWAP_BASE_URL=                   # optional; must be https (default https://www.tower.exchange)
#
# ── UnitFlow V3 on Arc Mainnet (chain 5042) ──
# V3 core family PINNED in src/lib/config/unitflow.ts (MAINNET_V3_FAMILY,
# bytecode-verified live 2026-09-23 via scripts/verify-unitflow-mainnet-
# bytecode.mjs — 9/9 carry bytecode, Factory/Quoter match testnet sizes):
#   Factory 0x5bfBCeb73d39F722B1cB83fD2F11736b28c1Be6d
#   Quoter 0x5AF6E89F0960Ff375AF84d9911D8153ef6240E34
#   V3Router 0x6fD8351b9596C1F0b2f2479BfA6A171cb3d0f410 (direct SwapRouter
#     executor — NO UniversalRouter exists on mainnet, none is needed;
#     mainnet executes exactInputSingle directly against this address)
#   PositionManager 0x300F5f2861eF0d9D3c6B812797C0A4c8b15C86a8
#   InterfaceMulticall 0xc9E1780bA34698C1067EA6B2fcF78f111a5F110b
#   TickLens 0x20Df732207340234E490a1e686A3A8055AF59b4e
#   NFTDescriptor 0x9Ca8e324380Aa2E80011A16C4d684366E47d4Ab4
#   PositionDescriptor 0x5Bc0735F5D806C184EDE0A7731632F7c491B3B02
#   V3Migrator 0x36E9b24b9CF39c4C7069B75f01FA0419547F977a
# Mainnet executor needs NO env: direct V3Router (pinned above), canonical
# Permit2 0x000000000022D473030F116dDEE9F6B43aC78BA3 (same on all Arc
# networks), canonical native USDC 0x3600000000000000000000000000000000000000
# (no WUSDC wrapper exists on Arc — docs.arc.io). Legacy
# UNITFLOW_MAINNET_UNIVERSAL_ROUTER / UNITFLOW_MAINNET_WUSDC are RETIRED
# (ignored when set); Factory/Quoter/Permit2/USDC accept an explicit override:
# UNITFLOW_MAINNET_FACTORY=              # optional override of the pinned mainnet Factory
# UNITFLOW_MAINNET_QUOTER=               # optional override of the pinned mainnet Quoter
# UNITFLOW_MAINNET_PERMIT2=              # optional override of the canonical Permit2 pin
# UNITFLOW_MAINNET_USDC=                 # optional override of the canonical USDC leg (defaults to ARC_MAINNET_USDC_ADDRESS, then 0x3600…0000)
# UNITFLOW_MAINNET_CHAIN_ID=             # optional; default 5042 (keep aligned with ARC_MAINNET_CHAIN_ID)
#
# ── Operations / third-party (configure outside the repo before launch) ──
# UPSTASH_REDIS_REST_URL=                # rate limiting (falls back to in-memory without it)
# UPSTASH_REDIS_REST_TOKEN=
# RESEND_API_KEY=xxx                     # notifications (lazy init in notifications.ts; email channel disabled when unset)
# RESEND_FROM_EMAIL=                     # optional override (default onboarding@resend.dev)
# GROQ_API_KEY=                          # agent brain LLM
# GROQ_MODEL=                            # optional (default openai/gpt-oss-20b)
# SENTRY_DSN= / SENTRY_*                 # see sentry configs; confirm DSN + tracesSampleRate for prod
# NEXT_PUBLIC_BASE_URL=                  # canonical public origin for outbound links (checkout/escrow/QR/cards).
#                                        # Legacy alias NEXT_PUBLIC_API_BASE still honored. Local dev falls back to
#                                        # http://localhost:3000; production WITHOUT either var fails closed (throws).
# NEXT_PUBLIC_CHECKOUT_API_KEY=ac_pub_xxx
# INTERNAL_SETTLEMENT_API_KEY=arc_live_xxx
# ADMIN_SECRET=your_admin_secret
# CIRCLE_API_KEY=TEST_API_KEY:xxx        # mainnet: production Circle API key
# CIRCLE_ENTITY_SECRET=xxx               # mainnet: production entity secret
# CIRCLE_WALLET_SET_ID=xxx               # mainnet: production wallet set
# CIRCLE_ARC_BLOCKCHAIN_ID=              # optional override; default flows from ARC network config
# GAS_SPONSORSHIP_AMOUNT_WEI=            # optional gas sponsorship override
# PLATFORM_FEE_BPS=25
# TELEGRAM_BOT_TOKEN=xxx
# TELEGRAM_BOT_USERNAME=FlareHQ_Notifier_bot
# TELEGRAM_WEBHOOK_SECRET=xxx
#
# ==============================================================================
# RENDER MAINNET CHECKLIST (2026-09-23 activation pass — ARC_NETWORK=mainnet)
# Copy values into the Render service environment. Secrets stay in Render only.
# Confirmed mainnet values are documented inline; operator-provisioned values
# are marked REQUIRED with no default. Verified live 2026-09-23: chain 5042,
# RPC/explorer/USDC(6)/EURC(6)/CCTP-domain-26/transmitter resolve from the
# values below, and startup validation passes with ERC-8183 unset.
# ==============================================================================
#
# ── REQUIRED: network switch + Arc mainnet topology (app refuses to boot without) ──
# ARC_NETWORK=mainnet
# ARC_MAINNET_CHAIN_ID=5042
# ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
# ARC_MAINNET_EXPLORER_URL=https://explorer.arc.io
# ARC_MAINNET_GATEWAY_URL=https://gateway-api.circle.com
# ARC_MAINNET_CCTP_IRIS_URL=https://iris-api.circle.com/v2
# ARC_MAINNET_CCTP_DOMAIN=26
# ARC_MAINNET_CCTP_MESSAGE_TRANSMITTER=0x81D40F21F12A8F0E3252Bccb954D722d4c464B64
# ARC_MAINNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# ARC_MAINNET_EURC_ADDRESS=0xbEf5f6d51CB62b58e6A8f77868681825C6fe21c1
# ARC_MAINNET_CIRCLE_BLOCKCHAIN=           # REQUIRED, UNVERIFIED — confirm exact mainnet value with Circle docs (expected "ARC")
# ARC_MAINNET_X402_VERIFIER=               # REQUIRED, UNVERIFIED — x402 GatewayWalletBatched verifying contract on mainnet (testnet pin 0x0077777d7EBA4688BDeF3E311b846F25870A19B9)
#
# ── REQUIRED: the six mainnet contracts (verified on-chain 2026-09-23) ──
# JOB_ESCROW_CONTRACT_ADDRESS=0x017F4616d2ed07E3Ed4A5d8B2355ab4A19f5fC65
# SPEND_LIMIT_CONTRACT_ADDRESS=0xF9DA48a0165aA4D15F9db7431C1bA5E10513CEFE
# PAYROLL_CONTRACT_ADDRESS=0x456E10375715A06509D86B9851F1e4Ef6F9F6B8B
# SWAP_POOL_CONTRACT_ADDRESS=0xeb53A41E830695D5518C5816dE8e0D9C75D904b2      # fresh pool: UNSEEDED — quotes 503 until seeded (separate funded op)
# PAYMENT_ROUTER_CONTRACT_ADDRESS=0x0b0Bd51DD8dF7b2D54DfE4f4a21065FA41163B0F
# ARC_FLARE_STREAM_CONTRACT_ADDRESS=0x79230A415dF3B22cD8c7DDB9b7Cd1f860e95375e
#
# ── REQUIRED: wallets/keys/secrets/Circle (mainnet values — never testnet) ──
# SELLER_ADDRESS=0x... + SELLER_PRIVATE_KEY=0x...     # key must derive the address (startup-checked)
# BUYER_ADDRESS=0x... + BUYER_PRIVATE_KEY=0x...       # x402 payer / relayer EOA pair
# EOA_PRIVATE_KEY=0x... / RELAYER_PRIVATE_KEY=0x... / ARC_ADMIN_PRIVATE_KEY=0x... / ESCROW_ADMIN_PRIVATE_KEY=0x...
# X402_WALLET_ENCRYPTION_KEY= / CONSUMER_JWT_SECRET= / MERCHANT_JWT_SECRET= / INTERNAL_SETTLEMENT_API_KEY=
# TELEGRAM_BOT_TOKEN= / TELEGRAM_WEBHOOK_SECRET= / ADMIN_SECRET=
# CIRCLE_API_KEY= / CIRCLE_ENTITY_SECRET= / CIRCLE_WALLET_SET_ID=   # production Circle creds + mainnet wallet set
# DATABASE_URL=postgresql://...neon.tech/...          # Neon only — exactly ONE line, never Render Postgres
# PLATFORM_PAYER_WALLET_ID= / MERCHANT_SCA_ADDRESS=0x... / PLATFORM_PAYER_SCA=0x...   # mainnet Circle wallet id + SCAs
# CCTP_MAINNET_SOURCES_JSON=[{"id":"...","label":"...","circleBlockchain":"..."}]    # bridge sources (fail-closed without)
# CCTP_MAINNET_ARC_CHAIN_ID=Arc                        # UNVERIFIED — verify against installed bridge-kit BridgeChain enum
# NEXT_PUBLIC_BASE_URL=https://<your-render-domain>   # production without it fails closed
#
# ── OPTIONAL (leave unset unless needed) ──
# ARC_MAINNET_ERC8183_ADDRESS=             # leave UNSET — no verified mainnet address exists (jobs/hire/procurement 503 until set)
# ARC_MAINNET_RPC_FALLBACKS= / ARC_MAINNET_EIP155= / ARC_MAINNET_X402_NETWORK= / ARC_MAINNET_WALLETCONNECT_CHAIN_ID=
# UNITFLOW_MAINNET_FACTORY= / UNITFLOW_MAINNET_QUOTER= / UNITFLOW_MAINNET_PERMIT2= / UNITFLOW_MAINNET_USDC= / UNITFLOW_MAINNET_CHAIN_ID=
#   # ^ overrides only; mainnet UnitFlow family is code-pinned. Keep ROUTING_PROVIDER_TOWER_ENABLED and
#   # ROUTING_PROVIDER_UNITFLOW_V3_ENABLED UNSET (default-off) — Tower is quote-only, never an executor.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID= / NEXT_PUBLIC_CHECKOUT_API_KEY= / UPSTASH_* / RESEND_* / GROQ_* / SENTRY_DSN / CIRCLE_ARC_BLOCKCHAIN_ID=
#
# ── REMOVE / IGNORE on a mainnet service (stale testnet or deploy-time only) ──
# ARC_TESTNET_RPC / ARC_TESTNET_RPC_FALLBACKS=     # testnet-only; unread on mainnet — remove to avoid confusion
# SELLER_WALLET_ADDRESS=                           # DEPRECATED — hard startup error if set (no key exists)
# AGENTIC_COMMERCE_CONTRACT= / ARC_USDC_ADDRESS=   # legacy overrides, intentionally NOT honored — remove
# PRIVATE_KEY= / MAINNET_DEPLOYER_KEY=             # deploy-time only — NEVER on the Next.js server
# ARC_USDC_ADDRESS=0x3600… (COMMON section override) # leave at default or remove; authoritative config already resolves per-network USDC
