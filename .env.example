# ==============================================================================
# FLAREHQ CORE PLATFORM CONFIGURATIONS — EXAMPLE
# Copy to .env and fill with real secrets. Do NOT commit real secrets.
# ==============================================================================

# 🌐 ARC LAYER-1 BLOCKCHAIN ENVIRONMENT
ARC_TESTNET_RPC="https://rpc.testnet.arc.network"
ARC_CHAIN_ID="5042002"

# 💳 NATIVE USDC SYSTEM CONTRACT ON ARC
ARC_USDC_ADDRESS="0x3600000000000000000000000000000000000000"

# 💼 FLAREHQ MERCHANT COLLECTION WALLET
ARCFLARE_MERCHANT_WALLET="0xbD3FAD84e7a41D222c7C36947B0A3B1592F42154"

# 🔒 SECURITY & WEBHOOK DISPATCH KEYS
ARCFLARE_WEBHOOK_SECRET=af_sec_live_xxx
MERCHANT_WEBHOOK_ENDPOINT="http://localhost:3000/api/merchant-webhook"

# 💾 DATABASE ENVIRONMENT
DATABASE_URL="postgresql://user:password@localhost:5432/flarehq_db?sslmode=require"

# 🔑 WALLETCONNECT
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id
WALLETCONNECT_CHAIN_ID="eip155:5042002"

CIRCLE_API_KEY=TEST_API_KEY:xxx
CIRCLE_ENTITY_SECRET=xxx
ARC_ADMIN_PRIVATE_KEY=0x...
ADMIN_SECRET=your_admin_secret
INTERNAL_SETTLEMENT_API_KEY=arc_live_xxx
NEXT_PUBLIC_FACTORY_ADDRESS=0x...
NEXT_PUBLIC_VALIDATION_REGISTRY=0x...
NEXT_PUBLIC_CHECKOUT_API_KEY=ac_pub_xxx
SELLER_ADDRESS=0xc119bb61dCd7Ce422557485ecD17D679f44250a1
# Platform fee in basis points (25 = 0.25%, e.g. 25bps on a $100 checkout = $0.25) — debited from Circle merchant wallet after checkout SUCCESS
PLATFORM_FEE_BPS=25
SELLER_PRIVATE_KEY=0x...
EOA_PRIVATE_KEY=0x...
PRIVATE_KEY=0x...
BUYER_ADDRESS=0x...
BUYER_PRIVATE_KEY=0x...
AGENT_TOKEN_ID=851225
CIRCLE_WALLET_SET_ID=xxx
PAYROLL_CONTRACT_ADDRESS=0x...
SPEND_LIMIT_CONTRACT_ADDRESS=0x...
