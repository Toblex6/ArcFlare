// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PaymentLog {
  id            String   @id @default(uuid())
  reference     String   @unique // Still serves as the target transaction reference
  idempotencyKey String?  @unique // 👈 Added: Prevents duplicate raw API retries on initialize
  amount        Float
  currency      String
  chain         String
  senderEmail   String
  merchant      String
  status        String   // PENDING, SETTLED, EXPIRED
  arcTxHash     String?
  webhookUrl    String?
  timestamp     DateTime @default(now())
  expiresAt     DateTime?
  agentSCA      String?
}

model AgentRegistry {
  id             Int      @id @default(autoincrement())
  name           String
  tokenId        String   @unique
  scaAddress     String   @unique
  circleWalletId String?
  ownerNode      String
  metadataURI    String?
  status         String
  createdAt      DateTime @default(now())
  idempotencyKey String?  @unique // 👈 Added: Prevents duplicate deployments if agent/deploy retries on timeout
}

model ApiKey {
  id          Int       @id @default(autoincrement())
  key         String    @unique
  label       String
  ownerEmail  String?
  active      Boolean   @default(true)
  usageCount  Int       @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model Agent {
  id            String   @id @default(cuid())
  name          String
  walletAddress String   @unique
  scaAddress    String?
  capabilities  String[]
  pricePerJob   String
  createdAt     DateTime @default(now())
  jobs          Job[]
}

model Escrow {
  id              String    @id @default(uuid())
  reference       String    @unique
  idempotencyKey  String?   @unique // 👈 Added: Guarantees escrow is only provisioned once per payment intent
  amount          Float
  currency        String
  depositorSCA    String
  beneficiarySCA  String
  contractAddress String
  status          String    // ACTIVE, RELEASED, DISPUTED
  condition       String?
  deadline        DateTime?
  createdAt       DateTime  @default(now())
}

model Stream {
  id               String    @id @default(uuid())
  reference        String    @unique
  idempotencyKey   String?   @unique // 👈 Added: Protects programmable payment streams from duplicate creation loops
  senderSCA        String
  receiverSCA      String
  ratePerSecond    Float
  totalDeposited   Float
  totalStreamed    Float     @default(0)
  currency         String    @default("USDC")
  status           String    // ACTIVE, STOPPED, COMPLETED
  contractAddress  String
  txHash           String?
  webhookUrl       String?
  startedAt        DateTime  @default(now())
  stoppedAt        DateTime?
  contractStreamId String?   // bytes32 streamId returned by createStream()
}

model NanoPayment {
  id             String   @id @default(uuid())
  idempotencyKey String?   @unique // 👈 Added & Required: Critical for M2M agent payments to stop double spending on failure retries
  agentSCA       String
  merchantSCA    String
  amount         Float
  currency       String   @default("USDC")
  description    String?
  settled        Boolean  @default(false)
  batchRef       String?  // Tracks which block/CCTP sweep this belonged to
  createdAt      DateTime @default(now())
  expiresAt      DateTime? // 👈 Added: For micro-authorizations that clear out if not settled quickly
}
model Merchant {
  id           String   @id @default(uuid())
  email        String   @unique
  businessName String
  passwordHash String
  apiKey       String   @unique
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Job {
  id          String   @id @default(uuid())
  description String
  amount      Float
  status      String   // PENDING, COMPLETED, FAILED
  createdAt   DateTime @default(now())
  
  // The relation linking this job back to a specific Agent
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id])
}