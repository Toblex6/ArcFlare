generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PaymentLog {
  id           String   @id @default(uuid())
  reference    String   @unique
  amount       Float
  currency     String
  chain        String
  senderEmail  String
  merchant     String
  status       String
  timestamp    DateTime @default(now())
}