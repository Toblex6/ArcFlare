// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PaymentLog {
  id          String   @id @default(uuid())
  reference   String   @unique
  amount      Float
  currency    String
  chain       String
  senderEmail String
  merchant    String
  status      String
  arcTxHash   String?
  webhookUrl  String?
  timestamp   DateTime @default(now())
}

model AgentRegistry {
  id             Int      @id @default(autoincrement())
  name           String
  tokenId        String   @unique
  scaAddress     String   @unique
  circleWalletId String?
  ownerNode      String
  metadataURI    String?
  status         String
  createdAt      DateTime @default(now())
}

model ApiKey {
  id          Int       @id @default(autoincrement())
  key         String    @unique
  label       String
  ownerEmail  String?
  active      Boolean   @default(true)
  usageCount  Int       @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model Agent {
  id            String   @id @default(cuid())
  name          String
  walletAddress String   @unique
  scaAddress    String?
  capabilities  String[]
  pricePerJob   String
  createdAt     DateTime @default(now())
  jobs          Job[]
}

model Escrow {
  id              String   @id @default(cuid())
  contractAddress String
  buyerAddress    String
  agentAddress    String
  amount          String
  status          String   // pending | active | disputed | settled
  deliverable     Json?
  txHash          String?
  createdAt       DateTime @default(now())
  job             Job?
}

model Job {
  id          String   @id @default(cuid())
  title       String
  agentId     String
  escrowId    String?  @unique
  status      String
  createdAt   DateTime @default(now())
  agent       Agent    @relation(fields: [agentId], references: [id])
  escrow      Escrow?  @relation(fields: [escrowId], references: [id])
}