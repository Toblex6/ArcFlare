// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PaymentLog {
  id             String    @id @default(uuid())
  reference      String    @unique
  idempotencyKey String?   @unique
  amount         Float
  currency       String
  chain          String
  senderEmail    String
  merchant       String
  status         String
  arcTxHash      String?
  webhookUrl     String?
  timestamp      DateTime  @default(now())
  expiresAt      DateTime?
  agentSCA       String?
  circleTxId     String?
  payerSCA       String?
  merchantSCA    String?
  updatedAt      DateTime? @updatedAt
}

model AgentRegistry {
  id             Int     @id @default(autoincrement())
  name           String
  tokenId        String  @unique
  scaAddress     String  @unique
  circleWalletId String?
  ownerNode      String
  metadataURI    String?
  status         String

  description  String?
  skills       Json?
  pricing      Json?
  reputation   Int       @default(50)
  lastActiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt   // ✅ added @default(now())

  idempotencyKey String? @unique

  agents  Agent[]
  wallets CircleWallet[]
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  key        String    @unique
  label      String
  ownerEmail String?
  active     Boolean   @default(true)
  usageCount Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Agent {
  id            String   @id @default(cuid())
  name          String
  walletAddress String   @unique
  scaAddress    String?
  capabilities  String[]
  pricePerJob   String
  createdAt     DateTime @default(now())

  registryId Int?
  registry   AgentRegistry? @relation(fields: [registryId], references: [id])

  jobs        Job[]
  erc8183Jobs Erc8183Job[]
}

model Escrow {
  id              String    @id @default(uuid())
  reference       String    @unique
  idempotencyKey  String?   @unique
  amount          Float
  currency        String
  depositorSCA    String
  beneficiarySCA  String
  contractAddress String
  status          String
  condition       String?
  deadline        DateTime?
  createdAt       DateTime  @default(now())
}

model Stream {
  id               String    @id @default(uuid())
  reference        String    @unique
  idempotencyKey   String?   @unique
  senderSCA        String
  receiverSCA      String
  ratePerSecond    Float
  totalDeposited   Float
  totalStreamed    Float     @default(0)
  currency         String    @default("USDC")
  status           String
  contractAddress  String
  txHash           String?
  webhookUrl       String?
  startedAt        DateTime  @default(now())
  stoppedAt        DateTime?
  contractStreamId String?
}

model NanoPayment {
  id             String    @id @default(uuid())
  idempotencyKey String?   @unique
  agentSCA       String
  merchantSCA    String
  amount         Float
  currency       String    @default("USDC")
  description    String?
  settled        Boolean   @default(false)
  batchRef       String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
}

model Merchant {
  id           String   @id @default(uuid())
  email        String   @unique
  businessName String
  passwordHash String
  apiKey       String   @unique
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Job {
  id          String   @id @default(uuid())
  description String
  amount      Float
  status      String
  createdAt   DateTime @default(now())

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])
}

model Erc8183Job {
  id              String   @id @default(uuid())
  jobId           BigInt   @unique
  clientSCA       String
  providerSCA     String
  evaluatorSCA    String
  description     String
  budget          BigInt
  status          String
  deliverableHash String?
  reasonHash      String?
  txHashes        String[]
  hook            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiredAt       DateTime

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([clientSCA])
  @@index([providerSCA])
  @@index([evaluatorSCA])
  @@index([status])
  @@map("erc8183_jobs")
}

model Erc8183JobEvent {
  id          String   @id @default(uuid())
  jobId       BigInt
  eventType   String
  txHash      String
  blockNumber BigInt?
  timestamp   DateTime @default(now())
  data        Json?

  @@index([jobId])
  @@index([eventType])
  @@index([txHash])
  @@map("erc8183_job_events")
}

model CircleWallet {
  id          String    @id @default(uuid())
  walletId    String    @unique
  address     String    @unique
  walletSetId String
  blockchain  String    @default("ARC-TESTNET")
  accountType String    @default("SCA")
  label       String?
  ownerEmail  String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  walletSet       CircleWalletSet? @relation(fields: [walletSetId], references: [walletSetId])
  agentRegistry   AgentRegistry?   @relation(fields: [agentRegistryId], references: [id])
  agentRegistryId Int?

  @@index([address])
  @@index([walletSetId])
  @@index([label])
  @@map("circle_wallets")
}

model CircleWalletSet {
  id          String   @id @default(uuid())
  walletSetId String   @unique
  name        String
  createdAt   DateTime @default(now())

  wallets CircleWallet[]

  @@map("circle_wallet_sets")
}

model ScheduledPayment {
  id             String    @id @default(uuid())
  reference      String    @unique
  idempotencyKey String?   @unique
  payerSCA       String
  payerWalletId  String?
  receiverSCA    String
  amount         Float
  currency       String    @default("USDC")
  intervalDays   Int
  nextRunAt      DateTime
  lastRunAt      DateTime?
  runCount       Int       @default(0)
  maxRuns        Int?
  status         String    @default("ACTIVE")
  description    String?
  webhookUrl     String?
  createdAt      DateTime  @default(now())
}

model PayrollBatch {
  id             String    @id @default(uuid())
  batchRef       String    @unique
  payerSCA       String
  payerWalletId  String?
  totalAmount    Float
  currency       String    @default("USDC")
  recipientCount Int
  successCount   Int       @default(0)
  failedCount    Int       @default(0)
  status         String    @default("PROCESSING")
  results        Json?
  webhookUrl     String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
}
// ── x402 EOA Wallets ──────────────────────────────────────────────────────
// These are plain Externally Owned Accounts (EOA) used exclusively for
// x402 nanopayments. Circle's Gateway requires ECDSA signatures from EOAs,
// not EIP-1271 contract signatures from SCAs.
//
// SECURITY: Private keys are stored in plaintext. For testnet/demo only.
// Production should use a secrets manager (AWS Secrets Manager, Vault, etc.).
model X402EoaWallet {
  id          String   @id @default(uuid())
  address     String   @unique
  privateKey  String   // ⚠️ plaintext – testnet only
  label       String?
  createdAt   DateTime @default(now())

  @@map("x402_eoa_wallets")
}