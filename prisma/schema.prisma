// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PaymentLog {
  id             String    @id @default(uuid())
  reference      String    @unique
  idempotencyKey String?   @unique
  amount         Float
  currency       String
  chain          String
  senderEmail    String
  merchant       String
  status         String
  arcTxHash      String?
  circleTxId     String?
  webhookUrl     String?
  timestamp      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt
  expiresAt      DateTime?
  agentSCA       String?
}

model AgentRegistry {
  id             Int      @id @default(autoincrement())
  name           String
  tokenId        String   @unique
  scaAddress     String   @unique
  circleWalletId String?
  ownerNode      String
  metadataURI    String?
  status         String
  createdAt      DateTime @default(now())
  idempotencyKey String?  @unique // 👈 Prevents duplicate deployments if agent/deploy retries on timeout
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  key        String    @unique
  label      String
  ownerEmail String?
  active     Boolean   @default(true)
  usageCount Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Agent {
  id            String   @id @default(cuid())
  name          String
  walletAddress String   @unique
  scaAddress    String?
  capabilities  String[]
  pricePerJob   String
  createdAt     DateTime @default(now())
  jobs          Job[]

  // Connects to Erc8183Job
  erc8183Jobs Erc8183Job[]
}

model Escrow {
  id              String    @id @default(uuid())
  reference       String    @unique
  idempotencyKey  String?   @unique // 👈 Guarantees escrow is only provisioned once per payment intent
  amount          Float
  currency        String
  depositorSCA    String
  beneficiarySCA  String
  contractAddress String
  status          String // ACTIVE, RELEASED, DISPUTED
  condition       String?
  deadline        DateTime?
  createdAt       DateTime  @default(now())
}

model Stream {
  id               String    @id @default(uuid())
  reference        String    @unique
  idempotencyKey   String?   @unique // 👈 Protects programmable payment streams from duplicate creation loops
  senderSCA        String
  receiverSCA      String
  ratePerSecond    Float
  totalDeposited   Float
  totalStreamed    Float     @default(0)
  currency         String    @default("USDC")
  status           String // ACTIVE, STOPPED, COMPLETED
  contractAddress  String
  txHash           String?
  webhookUrl       String?
  startedAt        DateTime  @default(now())
  stoppedAt        DateTime?
  contractStreamId String? // bytes32 streamId returned by createStream()
}

model NanoPayment {
  id             String    @id @default(uuid())
  idempotencyKey String?   @unique // 👈 Critical for M2M agent payments to stop double spending on failure retries
  agentSCA       String
  merchantSCA    String
  amount         Float
  currency       String    @default("USDC")
  description    String?
  settled        Boolean   @default(false)
  batchRef       String? // Tracks which block/CCTP sweep this belonged to
  createdAt      DateTime  @default(now())
  expiresAt      DateTime? // 👈 For micro-authorizations that clear out if not settled quickly
}

model Merchant {
  id           String   @id @default(uuid())
  email        String   @unique
  businessName String
  passwordHash String
  apiKey       String   @unique
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// Your existing Job model (keep as is)
model Job {
  id          String   @id @default(uuid())
  description String
  amount      Float
  status      String // PENDING, COMPLETED, FAILED
  createdAt   DateTime @default(now())

  // The relation linking this job back to a specific Agent
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])
}

// ============================================
// ERC-8183 Job Marketplace Models
// ============================================

// ERC-8183 Job - Standard on-chain job marketplace
model Erc8183Job {
  id              String   @id @default(uuid())
  jobId           BigInt   @unique
  clientSCA       String
  providerSCA     String
  evaluatorSCA    String
  description     String
  budget          BigInt
  status          String
  deliverableHash String?
  reasonHash      String?
  txHashes        String[]
  hook            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiredAt       DateTime

  // Foreign key to Agent (optional)
  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([clientSCA])
  @@index([providerSCA])
  @@index([evaluatorSCA])
  @@index([status])
  @@map("erc8183_jobs")
}

// ERC-8183 Job Events - For audit trail
model Erc8183JobEvent {
  id          String   @id @default(uuid())
  jobId       BigInt // Reference to the job
  eventType   String // JobCreated, JobFunded, JobSubmitted, JobCompleted, JobRejected
  txHash      String // Transaction hash
  blockNumber BigInt? // Block number
  timestamp   DateTime @default(now())
  data        Json? // Additional event data (amount, deliverable, reason, etc.)

  @@index([jobId])
  @@index([eventType])
  @@index([txHash])
  @@map("erc8183_job_events")
}

// Circle Wallet - Track developer-controlled wallets
model CircleWallet {
  id          String    @id @default(uuid())
  walletId    String    @unique
  address     String    @unique
  walletSetId String
  blockchain  String    @default("ARC-TESTNET")
  accountType String    @default("SCA")
  label       String?
  ownerEmail  String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  // Relation to WalletSet
  walletSet CircleWalletSet? @relation(fields: [walletSetId], references: [walletSetId])

  @@index([address])
  @@index([walletSetId])
  @@index([label])
  @@map("circle_wallets")
}

// Wallet Set - Group of wallets (for agent owner+validator pairs)
model CircleWalletSet {
  id          String   @id @default(uuid())
  walletSetId String   @unique
  name        String
  createdAt   DateTime @default(now())

  // Relation to CircleWallet
  wallets CircleWallet[]

  @@map("circle_wallet_sets")
}

// ============================================
// Recurring Payments + Payroll
// ============================================

model ScheduledPayment {
  id             String    @id @default(uuid())
  reference      String    @unique
  idempotencyKey String?   @unique
  payerSCA       String
  payerWalletId  String?
  receiverSCA    String
  amount         Float
  currency       String    @default("USDC")
  intervalDays   Int // e.g. 7 for weekly, 30 for monthly
  nextRunAt      DateTime
  lastRunAt      DateTime?
  runCount       Int       @default(0)
  maxRuns        Int? // null = infinite until cancelled
  status         String    @default("ACTIVE") // ACTIVE, PAUSED, CANCELLED, COMPLETED
  description    String?
  webhookUrl     String?
  createdAt      DateTime  @default(now())
}

model PayrollBatch {
  id             String    @id @default(uuid())
  batchRef       String    @unique
  payerSCA       String
  payerWalletId  String?
  totalAmount    Float
  currency       String    @default("USDC")
  recipientCount Int
  successCount   Int       @default(0)
  failedCount    Int       @default(0)
  status         String    @default("PROCESSING") // PROCESSING, COMPLETED, PARTIAL_FAILURE, FAILED
  results        Json? // array of { recipientSCA, amount, txHash, status }
  webhookUrl     String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
}
