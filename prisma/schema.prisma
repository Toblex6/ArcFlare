// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PaymentLog {
  id          String   @id @default(uuid())
  reference   String   @unique
  amount      Float
  currency    String
  chain       String
  senderEmail String
  merchant    String
  status      String
  arcTxHash   String?
  webhookUrl  String?
  timestamp   DateTime @default(now())
}

model AgentRegistry {
  id             Int      @id @default(autoincrement())
  name           String
  tokenId        String   @unique
  scaAddress     String   @unique
  circleWalletId String?
  ownerNode      String
  metadataURI    String?
  status         String
  createdAt      DateTime @default(now())
}

model ApiKey {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  label       String
  ownerEmail  String?
  active      Boolean  @default(true)
  usageCount  Int      @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
}

model Agent {
  id            String   @id @default(cuid())
  name          String
  walletAddress String   @unique
  scaAddress    String?
  capabilities  String[]
  pricePerJob   String
  createdAt     DateTime @default(now())
  jobs          Job[]
}

model Escrow {
  id              String    @id @default(uuid())
  reference       String    @unique
  amount          Float
  currency        String
  depositorSCA    String
  beneficiarySCA  String
  contractAddress String
  status          String    // ACTIVE, RELEASED, DISPUTED
  condition       String?
  deadline        DateTime?
  createdAt       DateTime @default(now())
}

model Stream {
  id              String    @id @default(uuid())
  reference       String    @unique                   // 👈 Added
  senderSCA       String
  receiverSCA     String
  ratePerSecond   Float
  totalDeposited  Float
  totalStreamed   Float     @default(0)               // 👈 Added
  currency        String    @default("USDC")          // 👈 Added
  status          String    // ACTIVE, STOPPED, COMPLETED
  contractAddress String                              // 👈 Added
  txHash          String?                             // 👈 Added
  webhookUrl      String?                             // 👈 Added
  startedAt       DateTime  @default(now())
  stoppedAt       DateTime?
}

model NanoPayment {
  id           String   @id @default(uuid())
  agentSCA     String
  merchantSCA  String
  amount       Float
  currency     String   @default("USDC") // 👈 Added
  description  String?                   // 👈 Added
  settled      Boolean  @default(false)
  batchRef     String?                   // 👈 Added to track which block/CCTP sweep this belonged to
  createdAt    DateTime @default(now())
}

model Job {
  id          String   @id @default(uuid())
  description String
  amount      Float
  status      String   // PENDING, COMPLETED, FAILED
  createdAt   DateTime @default(now())
  
  // The relation linking this job back to a specific Agent
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id])
}