generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Payment {
  id           String   @id @default(cuid())
  reference    String   @unique
  amount       Float
  email        String
  merchantName String
  status       String
  createdAt    DateTime @default(now())
}