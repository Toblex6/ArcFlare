generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PaymentLog {
  id             String    @id @default(uuid())
  reference      String    @unique
  idempotencyKey String?   @unique
  amount         Float
  currency       String
  chain          String
  senderEmail    String    // 'pending@checkout' until a real payer settles (matches merchant links' convention)
  direction      String    @default("send") // "send" | "request" — explicit, not inferred
  merchant       String
  status         String
  arcTxHash      String?
  webhookUrl     String?
  timestamp      DateTime  @default(now())
  expiresAt      DateTime?
  agentSCA       String?
  circleTxId     String?
  payerSCA       String?
  merchantSCA    String?
  merchantId     String?   // FK to Merchant.id — resolves the real payout wallet at settlement
  updatedAt      DateTime? @updatedAt
}

model AgentRegistry {
  id             Int            @id @default(autoincrement())
  name           String
  tokenId        String         @unique
  scaAddress     String         @unique
  circleWalletId String?
  ownerNode      String
  metadataURI    String?
  status         String
  description    String?
  skills         Json?
  pricing        Json?
  reputation     Int            @default(50)
  lastActiveAt   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  idempotencyKey String?        @unique
  merchantId     String?        // owning merchant — null only for legacy/pre-scoping rows
  agents         Agent[]
  wallets        CircleWallet[]
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  key        String    @unique
  label      String
  ownerEmail String?
  active     Boolean   @default(true)
  usageCount Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Agent {
  id            String         @id @default(cuid())
  name          String
  walletAddress String         @unique
  scaAddress    String?
  capabilities  String[]
  pricePerJob   String
  createdAt     DateTime       @default(now())
  registryId    Int?
  registry      AgentRegistry? @relation(fields: [registryId], references: [id])
  jobs          Job[]
  erc8183Jobs   Erc8183Job[]
}

model Escrow {
  id              String    @id @default(uuid())
  reference       String    @unique
  idempotencyKey  String?   @unique
  amount          Float
  currency        String
  depositorSCA    String
  beneficiarySCA  String
  contractAddress String
  status          String
  condition       String?
  deadline        DateTime?
  createdAt       DateTime  @default(now())
  merchantId      String?   // owning merchant — null only for legacy/pre-scoping rows
}

model Stream {
  id               String    @id @default(uuid())
  reference        String    @unique
  idempotencyKey   String?   @unique
  senderSCA        String
  receiverSCA      String
  ratePerSecond    Float
  totalDeposited   Float
  totalStreamed    Float     @default(0)
  currency         String    @default("USDC")
  status           String
  contractAddress  String
  txHash           String?
  webhookUrl       String?
  startedAt        DateTime  @default(now())
  stoppedAt        DateTime?
  contractStreamId String?
}

model NanoPayment {
  id             String    @id @default(uuid())
  idempotencyKey String?   @unique
  agentSCA       String
  merchantSCA    String
  amount         Float
  currency       String    @default("USDC")
  description    String?
  settled        Boolean   @default(false)
  batchRef       String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
}

model Merchant {
  id                        String    @id @default(uuid())
  email                     String    @unique
  businessName              String
  passwordHash              String
  apiKey                    String?   @unique
  active                    Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  verificationCode          String?
  verificationCodeExpiresAt DateTime?
  verified                  Boolean   @default(false)

  // Payout wallet — Circle-managed by default, or merchant-supplied external address
  walletType       String    @default("CIRCLE") // "CIRCLE" | "EXTERNAL"
  walletAddress    String?   // SCA address that receives settlements
  circleWalletId   String?   // Circle wallet ID, only set when walletType = CIRCLE
}

model ConsumerAccount {
  id            String    @id @default(uuid())
  walletAddress String    @unique
  walletType    String    @default("CIRCLE") // "CIRCLE" | "EXTERNAL"
  circleWalletId String?
  walletSetId   String?   // needed to provision this same SCA address on additional chains (e.g. for bridging)
  email         String?   @unique // optional — recovery/notifications only, never required
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
}

model Job {
  id          String   @id @default(uuid())
  description String
  amount      Float
  status      String
  createdAt   DateTime @default(now())
  agentId     String
  merchantId  String?  // owning merchant — null only for legacy/pre-scoping rows
  agent       Agent    @relation(fields: [agentId], references: [id])
}

model Erc8183Job {
  id              String   @id @default(uuid())
  jobId           BigInt   @unique
  clientSCA       String
  providerSCA     String
  evaluatorSCA    String
  description     String
  budget          BigInt
  status          String
  deliverableHash String?
  reasonHash      String?
  txHashes        String[]
  hook            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiredAt       DateTime
  agentId         String?
  merchantId      String?  // owning merchant — null only for legacy/pre-scoping rows
  agent           Agent?   @relation(fields: [agentId], references: [id])

  @@index([jobId])
  @@index([clientSCA])
  @@index([providerSCA])
  @@index([evaluatorSCA])
  @@index([status])
  @@map("erc8183_jobs")
}

model Erc8183JobEvent {
  id          String   @id @default(uuid())
  jobId       BigInt
  eventType   String
  txHash      String
  blockNumber BigInt?
  timestamp   DateTime @default(now())
  data        Json?

  @@index([jobId])
  @@index([eventType])
  @@index([txHash])
  @@map("erc8183_job_events")
}

model CircleWallet {
  id              String          @id @default(uuid())
  walletId        String          @unique
  address         String          @unique
  walletSetId     String
  blockchain      String          @default("ARC-TESTNET")
  accountType     String          @default("SCA")
  label           String?
  ownerEmail      String?
  createdAt       DateTime        @default(now())
  lastUsedAt      DateTime?
  agentRegistryId Int?
  agentRegistry   AgentRegistry?  @relation(fields: [agentRegistryId], references: [id])
  walletSet       CircleWalletSet @relation(fields: [walletSetId], references: [walletSetId])

  @@index([address])
  @@index([walletSetId])
  @@index([label])
  @@map("circle_wallets")
}

model CircleWalletSet {
  id          String         @id @default(uuid())
  walletSetId String         @unique
  name        String
  createdAt   DateTime       @default(now())
  wallets     CircleWallet[]

  @@map("circle_wallet_sets")
}

model ScheduledPayment {
  id             String    @id @default(uuid())
  reference      String    @unique
  idempotencyKey String?   @unique
  payerSCA       String
  payerWalletId  String?
  receiverSCA    String
  amount         Float
  currency       String    @default("USDC")
  intervalDays   Int
  nextRunAt      DateTime
  lastRunAt      DateTime?
  runCount       Int       @default(0)
  maxRuns        Int?
  status         String    @default("ACTIVE")
  description    String?
  webhookUrl     String?
  createdAt      DateTime  @default(now())
}

model PayrollBatch {
  id             String    @id @default(uuid())
  batchRef       String    @unique
  payerSCA       String
  payerWalletId  String?
  totalAmount    Float
  currency       String    @default("USDC")
  recipientCount Int
  successCount   Int       @default(0)
  failedCount    Int       @default(0)
  status         String    @default("PROCESSING")
  results        Json?
  webhookUrl     String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
}

model X402EoaWallet {
  id         String   @id @default(uuid())
  address    String   @unique
  privateKey String
  label      String?
  createdAt  DateTime @default(now())

  @@map("x402_eoa_wallets")
}

model AgentBrainMemory {
  id        String   @id @default(uuid())
  sessionId String
  message   Json
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model MerchantBudget {
  id           String    @id @default(uuid())
  merchantId   String
  category     String    // e.g. "payroll", "marketing", "supplies" — freeform, merchant-defined
  monthlyLimit Float
  currency     String    @default("USDC")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([merchantId])
}

model MerchantReminder {
  id          String    @id @default(uuid())
  merchantId  String
  description String
  amount      Float?
  dueDate     DateTime
  recurring   Boolean   @default(false)
  intervalDays Int?     // only set if recurring
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([merchantId])
  @@index([dueDate])
}

