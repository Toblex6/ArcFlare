generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PaymentLog {
  id               String    @id @default(uuid())
  reference        String    @unique
  idempotencyKey   String?   @unique
  amount           Float
  currency         String
  chain            String
  senderEmail      String    // 'pending@checkout' until a real payer settles (matches merchant links' convention)
  direction        String    @default("send") // "send" | "request" — explicit, not inferred
  merchant         String
  status           String
  arcTxHash        String?
  webhookUrl       String?
  timestamp        DateTime  @default(now())
  expiresAt        DateTime?
  agentSCA         String?
  circleTxId       String?
  payerSCA         String?
  merchantSCA      String?
  merchantId       String?   // FK to Merchant.id — resolves the real payout wallet at settlement
  listingId        String?   // set when this payment was for a marketplace ApiListing (loose ref, same convention as merchantId above)
  gatewayReference String?   // Circle Gateway's batch settlement reference (a UUID) — NOT an onchain
                            // tx hash. Settlement happens later in a batch; arcTxHash stays null
                            // until a real onchain hash exists for it (not tracked yet, see
                            // merchant/analytics route's notTracked section).
  upstreamOk       Boolean?  // For marketplace/x402-proxied payments: whether the upstream targetUrl
                            // responded successfully AFTER payment settled. Null = not applicable
                            // (non-proxied payment) or not yet recorded.
  upstreamStatus   Int?      // The upstream's actual HTTP status code, for merchant debugging.
  updatedAt        DateTime? @updatedAt

  @@index([listingId])
}

model AgentRegistry {
  id             Int            @id @default(autoincrement())
  name           String
  tokenId        String         @unique
  scaAddress     String         @unique
  circleWalletId String?
  ownerNode      String
  metadataURI    String?
  status         String
  description    String?
  skills         Json?
  pricing        Json?
  reputation     Int            @default(50)
  lastActiveAt   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  idempotencyKey String?        @unique
  merchantId     String?        // owning merchant — null only for legacy/pre-scoping rows
  agents         Agent[]
  wallets        CircleWallet[]
}

model ApiListing {
  id              String    @id @default(uuid())
  slug            String    @unique // used in the gated route path: /api/x402/marketplace/pay/[slug]
  name            String
  description     String?
  categories      String[]  @default([])
  pricePerRequest String    // "$X.XX" format, passed straight into withGateway() unchanged
  docsUrl         String?
  targetUrl       String    // upstream API this listing proxies to once payment clears — not in the
                             // original spec, but a listing can't actually gate anything without it
  status          String    @default("DRAFT") // "DRAFT" | "PUBLISHED" | "SUSPENDED"
  merchantId      String?   // owning provider — null only for legacy/pre-scoping rows
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([merchantId])
  @@index([status])
  @@index([slug])
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  key        String    @unique
  label      String
  ownerEmail String?
  active     Boolean   @default(true)
  usageCount Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Agent {
  id            String         @id @default(cuid())
  name          String
  walletAddress String         @unique
  scaAddress    String?
  capabilities  String[]
  pricePerJob   String
  createdAt     DateTime       @default(now())
  registryId    Int?
  registry      AgentRegistry? @relation(fields: [registryId], references: [id])
  jobs          Job[]
  erc8183Jobs   Erc8183Job[]
}

model Escrow {
  id                 String    @id @default(uuid())
  reference          String    @unique
  idempotencyKey     String?   @unique
  amount             Float
  currency           String
  depositorSCA       String
  beneficiarySCA     String
  contractAddress    String
  status             String
  condition          String?
  contractEscrowId   String?
  deadline           DateTime?
  createdAt          DateTime  @default(now())
  merchantId         String?   // owning merchant — null only for legacy/pre-scoping rows

  txHash             String?
  releaseTxHash      String?
  disputeTxHash      String?
  disputeReason      String?
  disputedBy         String?
  depositorConfirmed Boolean   @default(false)
  beneficiaryConfirmed Boolean  @default(false)
  webhookUrl         String?
}

model Stream {
  id               String    @id @default(uuid())
  reference        String    @unique
  idempotencyKey   String?   @unique
  senderSCA        String
  receiverSCA      String
  ratePerSecond    Float
  totalDeposited   Float
  totalStreamed    Float     @default(0)
  currency         String    @default("USDC")
  status           String
  contractAddress  String
  txHash           String?
  webhookUrl       String?
  startedAt        DateTime  @default(now())
  stoppedAt        DateTime?
  contractStreamId String?
}

model NanoPayment {
  id             String    @id @default(uuid())
  idempotencyKey String?   @unique
  agentSCA       String
  merchantSCA    String
  amount         Float
  currency       String    @default("USDC")
  description    String?
  settled        Boolean   @default(false)
  batchRef       String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
}

model Merchant {
  id                        String    @id @default(uuid())
  email                     String    @unique
  businessName              String
  passwordHash              String
  apiKey                    String?   @unique
  active                    Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  verificationCode          String?
  verificationCodeExpiresAt DateTime?
  verified                  Boolean   @default(false)

  // Payout wallet — Circle-managed by default, or merchant-supplied external address
  walletType       String    @default("CIRCLE") // "CIRCLE" | "EXTERNAL"
  walletAddress    String?   // SCA address that receives settlements
  circleWalletId   String?   // Circle wallet ID, only set when walletType = CIRCLE
}

model ConsumerAccount {
  id             String    @id @default(uuid())
  walletAddress  String    @unique
  walletType     String    @default("CIRCLE") // "CIRCLE" | "EXTERNAL"
  circleWalletId String?
  walletSetId    String?   // needed to provision this same SCA address on additional chains (e.g. for bridging)
  email          String?   @unique // optional — recovery/notifications only, never required
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
}

model Job {
  id          String   @id @default(uuid())
  description String
  amount      Float
  status      String
  createdAt   DateTime @default(now())
  agentId     String
  merchantId  String?  // owning merchant — null only for legacy/pre-scoping rows
  agent       Agent    @relation(fields: [agentId], references: [id])
}

model Erc8183Job {
  id              String   @id @default(uuid())
  jobId           BigInt   @unique
  clientSCA       String
  providerSCA     String
  evaluatorSCA    String
  description     String
  budget          BigInt
  status          String
  deliverableHash String?
  reasonHash      String?
  txHashes        String[]
  hook            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiredAt       DateTime
  agentId         String?
  merchantId      String?  // owning merchant — null only for legacy/pre-scoping rows
  agent           Agent?   @relation(fields: [agentId], references: [id])

  @@index([jobId])
  @@index([clientSCA])
  @@index([providerSCA])
  @@index([evaluatorSCA])
  @@index([status])
  @@map("erc8183_jobs")
}

model Erc8183JobEvent {
  id          String   @id @default(uuid())
  jobId       BigInt
  eventType   String
  txHash      String
  blockNumber BigInt?
  timestamp   DateTime @default(now())
  data        Json?

  @@index([jobId])
  @@index([eventType])
  @@index([txHash])
  @@map("erc8183_job_events")
}

model CircleWallet {
  id              String          @id @default(uuid())
  walletId        String          @unique
  address         String          @unique
  walletSetId     String
  blockchain      String          @default("ARC-TESTNET")
  accountType     String          @default("SCA")
  label           String?
  ownerEmail      String?
  createdAt       DateTime        @default(now())
  lastUsedAt      DateTime?
  agentRegistryId Int?
  agentRegistry   AgentRegistry?  @relation(fields: [agentRegistryId], references: [id])
  walletSet       CircleWalletSet @relation(fields: [walletSetId], references: [walletSetId])

  @@index([address])
  @@index([walletSetId])
  @@index([label])
  @@map("circle_wallets")
}

model CircleWalletSet {
  id          String         @id @default(uuid())
  walletSetId String         @unique
  name        String
  createdAt   DateTime       @default(now())
  wallets     CircleWallet[]

  @@map("circle_wallet_sets")
}

model ScheduledPayment {
  id             String    @id @default(uuid())
  reference      String    @unique
  idempotencyKey String?   @unique
  payerSCA       String
  payerWalletId  String?
  receiverSCA    String
  amount         Float
  currency       String    @default("USDC")
  intervalDays   Int
  nextRunAt      DateTime
  lastRunAt      DateTime?
  runCount       Int       @default(0)
  maxRuns        Int?
  status         String    @default("ACTIVE")
  description    String?
  webhookUrl     String?
  createdAt      DateTime  @default(now())
}

model PayrollBatch {
  id             String    @id @default(uuid())
  batchRef       String    @unique
  payerSCA       String
  payerWalletId  String?
  totalAmount    Float
  currency       String    @default("USDC")
  recipientCount Int
  successCount   Int       @default(0)
  failedCount    Int       @default(0)
  status         String    @default("PROCESSING")
  results        Json?
  webhookUrl     String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
}

model X402EoaWallet {
  id             String   @id @default(uuid())
  address        String   @unique
  encryptedKey   String   // AES-256-GCM ciphertext (was plaintext "privateKey" — never shipped that way)
  keyIv          String   // GCM initialization vector, base64
  keyAuthTag     String   // GCM auth tag, base64
  merchantId     String?  @unique // one wallet per merchant for now; null only for pre-migration rows
  label          String?
  createdAt      DateTime @default(now())

  @@map("x402_eoa_wallets")
}

model AgentBrainMemory {
  id        String   @id @default(uuid())
  sessionId String
  message   Json
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model MerchantBudget {
  id           String   @id @default(uuid())
  merchantId   String
  category     String   // e.g. "payroll", "marketing", "supplies" — freeform, merchant-defined
  monthlyLimit Float
  currency     String   @default("USDC")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([merchantId])
}

model MerchantReminder {
  id           String   @id @default(uuid())
  merchantId   String
  description  String
  amount       Float?
  dueDate      DateTime
  recurring    Boolean  @default(false)
  intervalDays Int?     // only set if recurring
  completed    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([merchantId])
  @@index([dueDate])
}

model Notification {
  id         String   @id @default(uuid())
  merchantId String
  type       String   // e.g. "payment.received", "escrow.funded" — see NOTIFICATION_EVENTS in src/lib/notifications.ts
  title      String
  message    String
  data       Json?    // arbitrary event payload (reference, amount, txHash, etc.)
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([merchantId])
  @@index([merchantId, read])
  @@index([type])
}

model NotificationPreference {
  id             String   @id @default(uuid())
  merchantId     String   @unique
  emailEnabled   Boolean  @default(true)
  webhookEnabled Boolean  @default(false)
  inAppEnabled   Boolean  @default(true)
  webhookUrl     String?  // default target when an event doesn't carry its own webhookUrl
  mutedEvents    String[] @default([]) // event type strings the merchant opted OUT of — default is everything ON
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DisputeEvidence {
  id          String   @id @default(uuid())
  reference   String   // Escrow.reference this evidence belongs to
  submittedBy String   // SCA address of whoever submitted it
  role        String   // "depositor" | "beneficiary" — which side they're on
  type        String   @default("text") // "text" | "link" — kept simple; extend later if needed
  content     String
  createdAt   DateTime @default(now())

  @@index([reference])
}
