// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Agent Models ─────────────────────────────────────────────────────────────

model Agent {
  id            String   @id @default(cuid())
  name          String
  walletAddress String   @unique
  scaAddress    String?
  capabilities  String[]
  pricePerJob   String
  createdAt     DateTime @default(now())
  jobs          Job[]
}

model AgentRegistry {
  id             Int      @id @default(autoincrement())
  name           String
  tokenId        String   @unique
  scaAddress     String   @unique
  circleWalletId String?
  ownerNode      String
  metadataURI    String?
  status         String
  createdAt      DateTime @default(now())
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  key        String    @unique
  label      String
  ownerEmail String?
  active     Boolean   @default(true)
  usageCount Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

// ─── Payment Models ───────────────────────────────────────────────────────────

model PaymentLog {
  id          String   @id @default(uuid())
  reference   String   @unique
  amount      Float
  currency    String
  chain       String
  senderEmail String
  merchant    String
  status      String
  arcTxHash   String?
  webhookUrl  String?
  timestamp   DateTime @default(now())
}

// ─── Escrow Model ─────────────────────────────────────────────────────────────

model Escrow {
  id                   String    @id @default(uuid())
  reference            String    @unique
  amount               Float
  currency             String    @default("USDC")
  depositorSCA         String?
  beneficiarySCA       String?
  contractAddress      String?
  onchainId            String?
  factoryUsed          String?
  status               String    @default("PENDING")
  condition            String?
  deadline             DateTime?
  txHash               String?
  releaseTxHash        String?
  disputeTxHash        String?
  disputeReason        String?
  disputedBy           String?
  depositorConfirmed   Boolean   @default(false)
  beneficiaryConfirmed Boolean   @default(false)
  webhookUrl           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// ─── Stream Model ─────────────────────────────────────────────────────────────

model Stream {
  id              String    @id @default(uuid())
  reference       String    @unique
  senderSCA       String
  receiverSCA     String
  ratePerSecond   Float
  totalDeposited  Float
  totalStreamed    Float     @default(0)
  currency        String    @default("USDC")
  status          String
  contractAddress String?
  txHash          String?
  webhookUrl      String?
  startedAt       DateTime  @default(now())
  stoppedAt       DateTime?
}

// ─── NanoPayment Model ────────────────────────────────────────────────────────

model NanoPayment {
  id          String   @id @default(uuid())
  agentSCA    String
  merchantSCA String
  amount      Float
  currency    String   @default("USDC")
  description String?
  settled     Boolean  @default(false)
  batchRef    String?
  createdAt   DateTime @default(now())
}

// ─── Job Model ────────────────────────────────────────────────────────────────

model Job {
  id          String   @id @default(uuid())
  description String
  amount      Float
  status      String
  createdAt   DateTime @default(now())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id])
}
