{
  "compilerOptions": {
    "target": "ES2020", // 1. ✅ Upgraded from ES2017 to support BigInt literals natively
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules", 
    "src/app/dashboard/page.old.tsx", // 2. ✅ Excluded to silence legacy wagmi/rainbowkit missing module errors
    "src/lib/wagmi.ts"                // 2. ✅ Excluded to silence legacy wagmi/rainbowkit missing module errors
  ]
}